  "runtime": {
    "strategy": "SYSTEM_FIRST_THEN_PINNED_PORTABLE_NODE_PERSISTENT_WRANGLER_NO_SCRIPTS_DIRECT_JS",
    "node_version": "24.21.0",
    "node_win_x64_zip_sha256": "158f7685b44de51f6c0df1d153526cbcd3e1bc739a8dfc607721cef75de9e541",
    "wrangler_version": "4.135.0",
    "admin_required": false,
    "manual_install_required": false,
    "npm_cache_persistent": true,
    "network_retries": true,
    "failure_receipt": true,
    "failure_receipt_secret_free": true,
    "system_probe_failure_auto_fallback": true,
    "direct_node_npx_cli": false,
    "persistent_wrangler_package": true,
    "direct_node_wrangler_cli": true,
    "field_ecosystem_exact_runtime_ci": true,
    "windows_powershell_native_stderr_captured": true,
    "npm_ignore_scripts": true,
    "esbuild_platform_binary_required": true,
    "field_failure_target": "ESBUILD_POSTINSTALL_FAILURE"
  },
  "live_card": {
    "enabled": true,
    "endpoint": "/v1/device/live-card",
    "telegram_edit": true,
    "persistent_d1_state": true,
    "fallback_send_on_edit_failure": true,
    "inline_keyboard": true,
    "callback_acknowledgement": true
  },
  "report_exports": {
    "enabled": true,
    "cache_endpoint": "/v1/device/report",
    "cached_reports": [
      "summary",
      "technical"
    ],
    "telegram_pdf_buttons": true,
    "direct_typed_commands": [
      "/report",
      "/reporttech"
    ],
    "field_verified": false
  },
  "notes": "Nexus 0.1.10 targets the field-proven esbuild npm postinstall failure. The pinned portable Node/npm install now uses --ignore-scripts, requires the Windows @esbuild/win32-x64 binary to exist, then invokes Wrangler's JS entry directly through node.exe. Failed partial package trees are removed before bounded retries. Exact Node archive + no-scripts install + platform-binary presence + Wrangler --version are exercised on Windows CI. Zero-dollar; no manual Node/Wrangler install, secret re-entry, PowerShell or ZIP shuttle."
}
