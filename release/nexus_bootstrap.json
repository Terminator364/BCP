  "runtime": {
    "strategy": "SYSTEM_FIRST_THEN_PINNED_PORTABLE_NODE_PERSISTENT_WRANGLER_DIRECT_JS",
    "node_version": "24.21.0",
    "node_win_x64_zip_sha256": "158f7685b44de51f6c0df1d153526cbcd3e1bc739a8dfc607721cef75de9e541",
    "wrangler_version": "4.135.0",
    "admin_required": false,
    "manual_install_required": false,
    "npm_cache_persistent": true,
    "network_retries": true,
    "failure_receipt": true,
    "failure_receipt_secret_free": true,
    "system_probe_failure_auto_fallback": true,
    "direct_node_npx_cli": false,
    "persistent_wrangler_package": true,
    "direct_node_wrangler_cli": true,
    "field_ecosystem_exact_runtime_ci": true,
    "windows_powershell_native_stderr_captured": true,
    "portable_node_path_binding": true,
    "npm_lifecycle_child_node_probe": true,
    "system_node_independent_ci": true
  },
  "live_card": {
    "enabled": true,
    "endpoint": "/v1/device/live-card",
    "telegram_edit": true,
    "persistent_d1_state": true,
    "fallback_send_on_edit_failure": true,
    "inline_keyboard": true,
    "callback_acknowledgement": true,
    "rich_message_preferred": true,
    "rich_html_payload": true,
    "bot_api_min_feature": "10.3",
    "styled_callback_buttons": true,
    "v9_plain_fallback": true,
    "fallback_on_rich_send_failure": true,
    "fallback_on_rich_edit_failure": true,
    "notification_tiers": {
      "actionable": "AUDIBLE",
      "automatic_recovery": "SILENT",
      "watch": "DASHBOARD_ONLY"
    }
  },
  "report_exports": {
    "enabled": true,
    "cache_endpoint": "/v1/device/report",
    "cached_reports": [
      "summary",
      "devices",
      "mission",
      "technical"
    ],
    "telegram_pdf_buttons": true,
    "direct_typed_commands": [
      "/report",
      "/reporttech"
    ],
    "field_verified": false,
    "transport_parity": true
  },
  "notes": "Nexus 0.2.1 preserves the proven 0.2.0 portable runtime and adds Rich Cockpit V10 edge parity: rich-first live cards with mandatory V9 fallback, all four reports, and tiered notifications (human-action audible, auto-recovery silent, WATCH dashboard-only). No paid broadcast or media-heavy live card."
}
