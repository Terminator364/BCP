{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcp.local/schemas/bcp_incident_v1.schema.json",
  "title": "BCP Incident V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "incident_id",
    "project_id",
    "resource_id",
    "signature",
    "status",
    "attempts",
    "first_observed_at",
    "last_observed_at",
    "observation",
    "environment_fingerprint",
    "receipt_refs",
    "desired_generation",
    "field_certified"
  ],
  "properties": {
    "schema": {
      "const": "bcp.incident/1"
    },
    "incident_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "resource_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,159}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "status": {
      "enum": [
        "OPEN",
        "MATCHED",
        "RECONCILING",
        "WAITING_BACKOFF",
        "WAITING_RESOURCE",
        "WAITING_CAPABILITY",
        "NEEDS_REASONING",
        "RESOLVED",
        "FAILED_SAFE"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "first_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_retry_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observation": {
      "type": "object"
    },
    "environment_fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "matched_recipe_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "desired_generation": {
      "type": "integer",
      "minimum": 1
    },
    "receipt_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "last_error": {
      "type": [
        "object",
        "null"
      ]
    },
    "field_certified": {
      "const": false
    }
  }
}
