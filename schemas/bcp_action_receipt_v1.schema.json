{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcp.local/schemas/bcp_action_receipt_v1.schema.json",
  "title": "BCP Action Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "mission_id",
    "project_id",
    "action_id",
    "capability_id",
    "provider_id",
    "idempotency_key",
    "status",
    "result",
    "proof_scope",
    "field_certified",
    "durability",
    "committed_revision",
    "created_at",
    "evidence"
  ],
  "properties": {
    "schema": {"const": "bcp.action_receipt/1"},
    "receipt_id": {"type": "string", "minLength": 8, "maxLength": 200},
    "mission_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "action_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "job_id": {"type": ["string", "null"], "maxLength": 160},
    "step_id": {"type": ["string", "null"], "maxLength": 160},
    "capability_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "node_id": {"type": ["string", "null"], "maxLength": 160},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 240},
    "status": {
      "enum": [
        "ACCEPTED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "ROLLED_BACK",
        "WAITING_PROVIDER",
        "WAITING_RESOURCE",
        "WAITING_USER",
        "SKIPPED",
        "UNKNOWN"
      ]
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "OBSERVED",
        "DEFERRED",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "proof_scope": {
      "enum": [
        "REPOSITORY",
        "SIMULATION",
        "PROVIDER",
        "FIELD"
      ]
    },
    "field_certified": {"type": "boolean"},
    "durability": {
      "enum": [
        "OBSERVED_ONLY",
        "DURABLE_LOCAL",
        "OUTBOX_COMMITTED",
        "REPLICATED",
        "PROVIDER_COMMITTED"
      ]
    },
    "committed_revision": {"type": "integer", "minimum": 0},
    "fencing_token": {"type": ["integer", "null"], "minimum": 1},
    "content_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "predecessor_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "output_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "source_revision": {"type": ["string", "null"], "maxLength": 256},
    "environment_fingerprint": {"type": ["string", "null"], "maxLength": 512},
    "outbox_message_id": {"type": ["string", "null"], "maxLength": 200},
    "idempotent_replay": {"type": "boolean"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "kind", "status", "observed_at"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "kind": {
            "enum": [
              "EXIT_CODE",
              "FILE_READBACK",
              "HASH",
              "PROCESS_HEALTH",
              "HTTP_HEALTH",
              "SERVICE_STATE",
              "GIT_REVISION",
              "TEST_RESULT",
              "ARTIFACT_SIGNATURE",
              "PROVIDER_ACK",
              "DESTINATION_READBACK",
              "CUSTOM_VALIDATOR"
            ]
          },
          "status": {
            "enum": ["PASS", "FAIL", "OBSERVED", "NOT_APPLICABLE", "UNKNOWN"]
          },
          "value": {},
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "source": {"type": ["string", "null"], "maxLength": 500},
          "observed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "PARTIAL", "NOT_RUN", "UNKNOWN"]},
        "summary": {"type": ["string", "null"], "maxLength": 2000},
        "observed_revision": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effect_id", "state"],
        "properties": {
          "effect_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "state": {"enum": ["PLANNED", "APPLIED", "VERIFIED", "ROLLED_BACK", "FAILED"]},
          "journal_ref": {"type": ["string", "null"], "maxLength": 500}
        }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "class": {"type": "string", "maxLength": 160},
        "code": {"type": ["string", "null"], "maxLength": 160},
        "detail": {"type": ["string", "null"], "maxLength": 2000},
        "retryable": {"type": "boolean"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "committed_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"field_certified": {"const": true}},
        "required": ["field_certified"]
      },
      "then": {
        "properties": {"proof_scope": {"const": "FIELD"}}
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "SUCCEEDED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"result": {"const": "PASS"}}
      }
    }
  ]
}
