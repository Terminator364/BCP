{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcp.local/schemas/bcp_capability_manifest_v1.schema.json",
  "title": "BCP Capability Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capability_id",
    "provider_id",
    "version",
    "effect_class",
    "permission_class",
    "resource_class",
    "input_schema",
    "evidence_contract"
  ],
  "properties": {
    "schema": {
      "const": "bcp.capability_manifest/1"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "project_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "availability": {
      "enum": [
        "AVAILABLE",
        "DEGRADED",
        "TEMP_UNAVAILABLE",
        "AUTH_REQUIRED",
        "RESOURCE_HOLD",
        "UNSUPPORTED",
        "STALE"
      ]
    },
    "effect_class": {
      "enum": [
        "READ_ONLY",
        "SAFE_WRITE",
        "PROJECT_MUTATION",
        "BOUNDED_SYSTEM_CHANGE",
        "DESTRUCTIVE_OR_SECURITY_SENSITIVE"
      ]
    },
    "permission_class": {
      "enum": [
        "P0_READ",
        "P1_SAFE_WRITE",
        "P2_PROJECT_MUTATION",
        "P3_BOUNDED_SYSTEM_CHANGE",
        "P4_DESTRUCTIVE_OR_SECURITY_SENSITIVE"
      ]
    },
    "resource_class": {
      "enum": [
        "R0_TINY",
        "R1_LIGHT",
        "R2_MEDIUM",
        "R3_HEAVY",
        "R4_LOCAL_AI"
      ]
    },
    "requires_network": {
      "type": "boolean"
    },
    "requires_pc": {
      "type": "boolean"
    },
    "requires_bedge": {
      "type": "boolean"
    },
    "requires_admin": {
      "type": "boolean"
    },
    "preemptible": {
      "type": "boolean"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "strategy": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "evidence_contract": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "EXIT_CODE",
          "FILE_READBACK",
          "HASH",
          "PROCESS_HEALTH",
          "HTTP_HEALTH",
          "SERVICE_STATE",
          "GIT_REVISION",
          "TEST_RESULT",
          "ARTIFACT_SIGNATURE",
          "PROVIDER_ACK",
          "DESTINATION_READBACK",
          "CUSTOM_VALIDATOR"
        ]
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "INTERNAL",
            "POWERSHELL",
            "WIN32",
            "GIT",
            "PYTHON",
            "NODE",
            "BUILDHUB",
            "DELIVERY",
            "MODEL",
            "REMOTE_PROVIDER"
          ]
        },
        "entrypoint": {
          "type": "string",
          "maxLength": 500
        },
        "pinned_version": {
          "type": "string",
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
