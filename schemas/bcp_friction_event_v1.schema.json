{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcp.local/schemas/bcp_friction_event_v1.schema.json",
  "title": "BCP Friction Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "friction_id",
    "project_id",
    "signature",
    "category",
    "detail",
    "source",
    "avoidable",
    "user_action_required",
    "occurrence_count",
    "first_observed_at",
    "last_observed_at",
    "status",
    "field_certified"
  ],
  "properties": {
    "schema": {
      "const": "bcp.friction_event/1"
    },
    "friction_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "avoidable": {
      "type": "boolean"
    },
    "user_action_required": {
      "type": "boolean"
    },
    "occurrence_count": {
      "type": "integer",
      "minimum": 1
    },
    "first_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "OPEN",
        "ACKNOWLEDGED",
        "RESOLVED"
      ]
    },
    "field_certified": {
      "const": false
    }
  }
}
