{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcp.local/schemas/bcp_release_candidate_v1.schema.json",
  "title": "BCP Release Candidate V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_id",
    "project_id",
    "sequence",
    "version",
    "source",
    "artifact",
    "provenance",
    "qualification_policy",
    "activation_policy",
    "created_at"
  ],
  "properties": {
    "schema": {"const": "bcp.release_candidate/1"},
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,199}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "sequence": {"type": "integer", "minimum": 1},
    "version": {"type": "string", "minLength": 1, "maxLength": 160},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 300},
        "revision": {"type": "string", "minLength": 7, "maxLength": 256},
        "path": {"type": ["string", "null"], "maxLength": 1024}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "locator", "sha256"],
      "properties": {
        "transport": {
          "enum": [
            "GITHUB_RELEASE",
            "GITHUB_BLOB",
            "HTTPS_HASH_PINNED",
            "PRIVATE_DRIVE_STABLE_CURRENT",
            "BUILDHUB",
            "LOCAL_STAGED",
            "PROJECT_NATIVE"
          ]
        },
        "locator": {"type": "string", "minLength": 1, "maxLength": 2048},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder_class", "build_recipe_ref"],
      "properties": {
        "builder_class": {
          "enum": [
            "GITHUB_ACTIONS",
            "BUILDHUB",
            "PROJECT_NATIVE",
            "EXTERNAL_VERIFIED"
          ]
        },
        "build_recipe_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "dependency_lock_ref": {"type": ["string", "null"], "maxLength": 512},
        "signer": {"type": ["string", "null"], "maxLength": 256},
        "signature_ref": {"type": ["string", "null"], "maxLength": 1024}
      }
    },
    "qualification_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_capabilities",
        "field_evidence_required"
      ],
      "properties": {
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
          }
        },
        "field_evidence_required": {"type": "boolean"}
      }
    },
    "activation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollback_required",
        "field_activation_required",
        "migration"
      ],
      "properties": {
        "rollback_required": {"type": "boolean"},
        "field_activation_required": {"type": "boolean"},
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "rollback_compatible"],
          "properties": {
            "class": {
              "enum": ["NONE", "REVERSIBLE", "MIGRATION_REQUIRED"]
            },
            "rollback_compatible": {"type": "boolean"},
            "migration_ref": {"type": ["string", "null"], "maxLength": 512}
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string", "maxLength": 1000}
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
