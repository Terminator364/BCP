{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcp.local/schemas/bcp_cross_project_catalog_v1.schema.json",
  "title": "BCP Cross Project Catalog V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "created_at",
    "projects",
    "adapters",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "bcp.cross_project_catalog/1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./bcp_project_record_v1.schema.json"
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./bcp_project_adapter_v1.schema.json"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "status",
          "repository",
          "revision",
          "evidence"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
          },
          "status": {
            "enum": [
              "OBSERVED",
              "PARTIAL",
              "UNRESOLVED"
            ]
          },
          "repository": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "revision": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
