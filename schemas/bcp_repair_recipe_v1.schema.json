{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcp.local/schemas/bcp_repair_recipe_v1.schema.json",
  "title": "BCP Repair Recipe V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "recipe_id", "version", "status", "auto_eligible",
    "match", "policy", "steps", "source_revision"
  ],
  "properties": {
    "schema": {"const": "bcp.repair_recipe/1"},
    "recipe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "status": {"enum": ["DRAFT", "REPOSITORY_VALIDATED", "FIELD_VALIDATED", "RETIRED"]},
    "auto_eligible": {"type": "boolean"},
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incident_class"],
      "properties": {
        "incident_class": {"enum": ["DRIFT", "FRICTION", "CAPABILITY", "RESOURCE", "PROVIDER", "AUTH", "UPDATE", "UNKNOWN"]},
        "resource_kind": {"type": ["string", "null"], "maxLength": 128},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
        "project_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_permission_class", "max_resource_class", "max_attempts", "backoff_seconds", "rollback_required"],
      "properties": {
        "max_permission_class": {"enum": ["P0_READ", "P1_SAFE_WRITE", "P2_PROJECT_MUTATION", "P3_BOUNDED_SYSTEM_CHANGE"]},
        "max_resource_class": {"enum": ["R0_TINY", "R1_LIGHT", "R2_MEDIUM", "R3_HEAVY", "R4_LOCAL_AI"]},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
        "backoff_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "rollback_required": {"type": "boolean"}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "capability_id", "permission_class", "resource_class", "evidence_contract", "on_failure"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
          "capability_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"},
          "permission_class": {"enum": ["P0_READ", "P1_SAFE_WRITE", "P2_PROJECT_MUTATION", "P3_BOUNDED_SYSTEM_CHANGE"]},
          "resource_class": {"enum": ["R0_TINY", "R1_LIGHT", "R2_MEDIUM", "R3_HEAVY", "R4_LOCAL_AI"]},
          "evidence_contract": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["EXIT_CODE", "FILE_READBACK", "HASH", "PROCESS_HEALTH", "HTTP_HEALTH", "SERVICE_STATE", "GIT_REVISION", "TEST_RESULT", "ARTIFACT_SIGNATURE", "PROVIDER_ACK", "DESTINATION_READBACK", "CUSTOM_VALIDATOR"]}
          },
          "input_defaults": {"type": "object"},
          "on_failure": {"enum": ["STOP_FAIL_SAFE", "NEXT_RECIPE", "ROLLBACK", "NEEDS_REASONING"]}
        }
      }
    },
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "ledger_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "regression_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "notes": {"type": "array", "items": {"type": "string", "maxLength": 1000}}
  },
  "allOf": [
    {
      "if": {"properties": {"auto_eligible": {"const": true}}, "required": ["auto_eligible"]},
      "then": {"properties": {"status": {"const": "FIELD_VALIDATED"}}}
    }
  ]
}
