{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcp.local/schemas/bcp_cockpit_projection_v1.schema.json",
  "title": "BCP Human Cockpit Projection V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projection_id",
    "project_id",
    "mission_id",
    "canonical_state",
    "human_state",
    "activity",
    "finite_progress",
    "current_step",
    "last_completed_step",
    "next_step",
    "human_action",
    "last_proof",
    "connectivity",
    "technical_refs",
    "source_revision",
    "generated_at",
    "field_certified"
  ],
  "properties": {
    "schema": {"const": "bcp.cockpit_projection/1"},
    "projection_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,199}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "mission_id": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "canonical_state": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "human_state": {
      "enum": ["WORKING", "WAITING", "BLOCKED", "NEEDS_YOU", "DONE", "DEGRADED", "UNKNOWN"]
    },
    "activity": {
      "enum": [
        "RECENT_EVIDENCE",
        "WAITING_EXTERNAL",
        "NO_NEW_EXTERNAL_EVIDENCE",
        "BLOCKED",
        "DONE",
        "UNKNOWN"
      ]
    },
    "finite_progress": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed", "total", "percent", "plan_revision"],
          "properties": {
            "completed": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 1},
            "percent": {"type": "integer", "minimum": 0, "maximum": 100},
            "plan_revision": {"type": "string", "minLength": 1, "maxLength": 160}
          }
        }
      ]
    },
    "current_step": {"type": ["string", "null"], "maxLength": 500},
    "last_completed_step": {"type": ["string", "null"], "maxLength": 500},
    "next_step": {"type": ["string", "null"], "maxLength": 500},
    "human_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "instruction"],
      "properties": {
        "state": {"enum": ["NONE", "REQUIRED", "OPTIONAL"]},
        "instruction": {"type": ["string", "null"], "maxLength": 1000}
      }
    },
    "last_proof": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "state",
            "summary",
            "source_node",
            "observed_at",
            "evidence_refs"
          ],
          "properties": {
            "sequence": {"type": "integer", "minimum": 0},
            "state": {"type": "string", "minLength": 1, "maxLength": 128},
            "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
            "source_node": {"type": "string", "minLength": 1, "maxLength": 160},
            "observed_at": {"type": "string", "format": "date-time"},
            "evidence_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          }
        }
      ]
    },
    "connectivity": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transport",
          "provider_id",
          "node_id",
          "state",
          "evidence_class",
          "observed_at",
          "fresh"
        ],
        "properties": {
          "transport": {
            "enum": [
              "LOCAL_NATIVE",
              "GITHUB",
              "BUILDHUB",
              "TELEGRAM",
              "DRIVE",
              "NEXUS",
              "B_EDGE",
              "DESKTOP_COMMANDER",
              "REMOTE_PROVIDER",
              "NONE"
            ]
          },
          "provider_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "node_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "state": {
            "enum": ["OK", "DEGRADED", "OFFLINE", "WAITING_AUTH", "STALE", "UNKNOWN"]
          },
          "evidence_class": {
            "enum": [
              "REPOSITORY_STATIC",
              "SIMULATION",
              "PROVIDER_PROBE",
              "FIELD_READBACK",
              "SELF_REPORTED",
              "UNKNOWN"
            ]
          },
          "observed_at": {"type": "string", "format": "date-time"},
          "fresh": {"type": "boolean"}
        }
      }
    },
    "technical_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "generated_at": {"type": "string", "format": "date-time"},
    "field_certified": {"const": false}
  }
}
