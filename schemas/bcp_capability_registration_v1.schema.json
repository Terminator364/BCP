{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcp.local/schemas/bcp_capability_registration_v1.schema.json",
  "title": "BCP Capability Registration V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","registration_id","candidate_id","project_id",
    "capability_id","provider_id","version","trust_class",
    "manifest","gate_receipts","registered_at","field_certified"
  ],
  "properties": {
    "schema": {"const": "bcp.capability_registration/1"},
    "registration_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,199}$"
    },
    "candidate_id": {"type": "string","minLength": 8,"maxLength": 200},
    "project_id": {"type": "string","minLength": 2,"maxLength": 128},
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "provider_id": {"type": "string","minLength": 1,"maxLength": 128},
    "version": {"type": "string","minLength": 1,"maxLength": 64},
    "trust_class": {
      "enum": ["T0_BUILTIN","T1_VERIFIED_LOCAL","T2_VERIFIED_REMOTE"]
    },
    "manifest": {"$ref": "./bcp_capability_manifest_v1.schema.json"},
    "gate_receipts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string","minLength": 8,"maxLength": 200}
    },
    "source_revision": {"type": ["string","null"],"maxLength": 256},
    "registered_at": {"type": "string","format": "date-time"},
    "field_certified": {"const": false}
  }
}
