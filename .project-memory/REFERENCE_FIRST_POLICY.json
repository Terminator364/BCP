{
  "schema": "bcp.reference_first_policy/1",
  "status": "CANONICAL_CANDIDATE_R89_RECONCILED",
  "adopted_at": "2026-09-22",
  "scope": "ALL_NEW_BCP_UI_FLOW_SERVICE_PROTOCOL_MODULE_OR_MAJOR_BEHAVIOR",
  "objective": "DO_NOT_REINVENT_MATURE_PATTERNS; COMPOSE_PROVEN_SOLUTIONS_AROUND_BCP_DIFFERENTIATORS",
  "pipeline": [
    "LOAD_CURRENT_A_PLUS_B_PLUS_C",
    "IDENTIFY_USER_JOB_AND_FIELD_CONSTRAINTS",
    "SEARCH_MATURE_EXTERNAL_REFERENCES",
    "MAP_CURRENT_IMPLEMENTATION_TO_REFERENCES",
    "CLASSIFY_REUSE_ADAPT_BUILD_ONLY_IF_GAP",
    "VERIFY_LICENSE_AND_PROVENANCE_BEFORE_CODE_REUSE",
    "DESIGN_TARGET_USER_JOURNEY",
    "DEFINE_REPRESENTATIVE_TASK_BASED_ACCEPTANCE",
    "IMPLEMENT_COHERENT_SLICE",
    "QUALIFY_EXACT_HEAD",
    "FIELD_GATE_ONLY_WHEN_USER_ACTION_IS_IRREDUCIBLE"
  ],
  "classification": {
    "REUSE": "Reuse a proven compatible component or standard where licence, footprint and constraints fit.",
    "ADAPT": "Implement BCP-owned code following a proven interaction/architecture pattern while preserving BCP constraints.",
    "BUILD_ONLY_IF_GAP": "Custom design permitted only with documented reference mismatch or measured field gap."
  },
  "minimum_reference_rule": {
    "when_mature_pattern_plausibly_exists": 2,
    "source_priority": [
      "OFFICIAL_PLATFORM_DOCUMENTATION",
      "MATURE_OPEN_SOURCE_IMPLEMENTATION",
      "MATURE_PRODUCT_DOCUMENTATION",
      "INDUSTRY_RELIABILITY_GUIDANCE",
      "TUTORIAL_OR_VIDEO_FOR_HUMAN_FLOW_OBSERVATION_ONLY"
    ],
    "no_reference_exception_requires_reason": true
  },
  "license_and_provenance": {
    "noncommercial_is_not_license_exemption": true,
    "copy_external_code_before_license_review": false,
    "pattern_learning_without_code_copy_allowed": true,
    "source_names_and_links_may_be_recorded": true,
    "attribution_or_notice_required_when_license_requires_it": true,
    "registry_ref": ".project-memory/EXTERNAL_REFERENCE_REGISTRY.json"
  },
  "ui_rules": {
    "progressive_disclosure": true,
    "primary_screen_answers": [
      "IS_SYSTEM_OK",
      "WHAT_IS_IT_DOING",
      "DOES_IT_NEED_USER",
      "WHAT_HAPPENED_LAST",
      "WHAT_IS_NEXT"
    ],
    "frequent_actions_in_settings_forbidden": true,
    "settings_scope": "INFREQUENT_PREFERENCES_AND_CONFIGURATION",
    "advanced_diagnostics_secondary": true,
    "exactly_one_primary_human_cta_when_blocked": true,
    "task_completion_tests_over_string_presence": true,
    "compact_320x640_primary_action_without_scroll": true
  },
  "transport_rules": {
    "default_ladder": [
      "LOCAL_DIRECT_ENCRYPTED",
      "LOCAL_ALTERNATE_DISCOVERY",
      "RELAY_IF_NEEDED",
      "DURABLE_STORE_AND_FORWARD"
    ],
    "new_transport_requires_measured_gap": true,
    "diagnostic_subnet_scan_not_primary_discovery": true
  },
  "reliability_rules": {
    "mutation_tunnel": [
      "REQUEST_ID",
      "VALIDATE",
      "INTENT_PERSISTED",
      "EFFECT_ATTEMPT",
      "PROVIDER_OR_DEVICE_ACK",
      "READBACK",
      "COMMIT_RECEIPT",
      "RECONCILE_IF_UNKNOWN"
    ],
    "unknown_outcome_is_success": false,
    "unknown_outcome_is_failure": false,
    "retry_same_intent_reuses_idempotency_key": true,
    "changed_intent_requires_new_idempotency_key": true,
    "transactional_outbox_when_state_and_delivery_must_be_coherent": true
  },
  "product_release_rules": {
    "no_new_micro_beta_for_reference_gap": true,
    "batch_related_reference_deltas_into_coherent_candidate": true,
    "current_bedge_2_2_role": "TECHNICAL_BASELINE_NOT_TARGET_UX",
    "next_user_install_deferred_until_reference_reconciliation": true,
    "product_or_release_bytes_changed_by_r89": false
  },
  "required_pr_evidence": [
    "REFERENCE_REGISTRY_IDS",
    "REQUIREMENT_IDS",
    "USER_FEEDBACK_OR_FIELD_EVIDENCE",
    "REUSE_ADAPT_BUILD_DECISION",
    "LICENSE_STATUS_IF_CODE_REUSED",
    "TARGET_USER_JOURNEY",
    "REPRESENTATIVE_ACCEPTANCE_TEST"
  ],
  "benchmark_doc": "docs/BCP_R89_ANTI_REINVENTION_BENCHMARK.md",
  "source_adoption_matrix": ".project-memory/BCP_R89_SOURCE_ADOPTION_MATRIX.json"
}
