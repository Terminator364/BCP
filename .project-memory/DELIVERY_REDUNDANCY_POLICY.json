{
  "schema": "bcp.delivery_redundancy_policy/13",
  "revision": "2026-09-22-R88",
  "status": "CANONICAL_CANDIDATE",
  "channels": {
    "chatgpt": {
      "role": "POINTER_ONLY_AFTER_SUCCESSFUL_EMAIL_END_ACK",
      "delivery_is_not_assumed_reliable": true,
      "detailed_checkpoint_body_forbidden_after_successful_email": true,
      "required_pointer_fields": [
        "MAIL_SENT",
        "KINSHASA_DAY_DATE_TIME",
        "CHECKPOINT_ID"
      ],
      "allowed_pointer_example": "Va sur Gmail — lundi 21 septembre 2026, 02:23 Kinshasa — BCP-R59-...",
      "no_user_relaunch_dependency": true
    },
    "email": {
      "role": "SOLE_PRIMARY_DETAILED_HUMAN_CHECKPOINT_DELIVERY",
      "full_checkpoint_body_required": true,
      "subject_must_include_checkpoint_id": true,
      "action_instruction_supersession_required": true,
      "send_before_chat_pointer": true,
      "failure_behavior": "RETRY_END_EMAIL_UNTIL_PROVIDER_SEND_ACK; DO_NOT_EMIT_ANY_CHATGPT_END_MESSAGE_OR_POINTER_BEFORE_SUCCESSFUL_END_EMAIL_ACK",
      "start_notice_required_before_substantive_work": true,
      "end_checkpoint_required": true,
      "start_notice_purpose": "CONFIRM_TRANCHE_STARTED_BEFORE_SUBSTANTIVE_PROJECT_WORK",
      "start_notice_required_fields": [
        "PROJECT",
        "KINSHASA_DATE_TIME",
        "WORK_SCOPE",
        "ESTIMATED_END_WINDOW_LOCAL"
      ],
      "end_checkpoint_required_fields": [
        "PROJECT",
        "KINSHASA_DATE_TIME",
        "CHECKPOINT_ID",
        "WORK_DONE",
        "EVIDENCE",
        "NEXT_ACTION_OR_GATE"
      ],
      "end_mail_retry_required": true,
      "end_mail_provider_ack_required": true,
      "chat_output_before_end_ack_forbidden": true,
      "project_label_required": true,
      "project_label_name": "BCP",
      "project_label_create_if_missing": true,
      "label_apply_to": [
        "EMAIL_START_NOTICE",
        "EMAIL_ESTIMATE_UPDATE_IF_MATERIAL",
        "EMAIL_END_FULL_CHECKPOINT"
      ],
      "end_mail_search_before_send": true,
      "end_mail_idempotency_key_required": true,
      "end_mail_readback_required": true,
      "scheduler_completion_is_not_delivery_proof": true,
      "foreground_end_send_primary": true,
      "backup_end_must_be_minimal_and_precomposed": true,
      "delivery_key_required": true,
      "start_message_id_persist_required": true,
      "end_message_id_persist_required": true,
      "prefer_reply_to_start_thread": true,
      "reply_rejection_fallback": "SEARCH_SENT_BY_DELIVERY_KEY_THEN_STANDALONE_SEND"
    },
    "telegram": {
      "role": "SECONDARY_WITNESS_ALERT_AND_RECOVERY_NAVIGATION",
      "must_not_replace_email_exact_mirror": true,
      "stale_seen_alerts_are_not_runtime_failures": true
    }
  },
  "cadence": {
    "scheduling_model": "ADAPTIVE_TASK_WINDOW",
    "fixed_minutes": null,
    "checkpoint_each_tranche": true,
    "mail_each_tranche": true,
    "blind_retry_loops": false,
    "start_mail_each_tranche": true,
    "start_mail_includes_estimated_end_window": true,
    "estimate_update_mail": "OPTIONAL_IF_ESTIMATE_MATERIALLY_CHANGES",
    "end_mail_each_tranche": true,
    "user_relaunch_must_never_be_required": true,
    "scheduled_close_guards_required": false,
    "closeout_behavior": "PRIMARY_ASSISTANT_CLOSES_AT_REAL_CHECKPOINT_OR_TRUE_GATE; SEARCH_SENT_BY_DELIVERY_KEY; SEND_END_IF_MISSING; VERIFY_PROVIDER_ACK; PERSIST_CLOSED; THEN_CHAT_POINTER",
    "success_metric": "DURABLE_PRODUCT_PROGRESS_NOT_ELAPSED_TIME"
  },
  "action_message_contract": {
    "one_human_gate_at_a_time": true,
    "latest_action_instruction_supersedes_older_action_instructions": true,
    "checkpoint_id_required": true,
    "manual_first_when_network_is_unreliable": true,
    "chat_pointer_must_not_duplicate_full_checkpoint": true,
    "project_label_required": true
  },
  "packaging": {
    "single_extraction_preferred": true,
    "nested_zip_for_user_action_forbidden": true,
    "current_folder": "API_BCP/00_INSTALL_CURRENT",
    "replace_current_in_place": true,
    "cleanup_superseded_current_artifacts": true,
    "single_extraction_required_for_user_current": true
  },
  "propagation": "PORT_ON_NEXT_TOUCH_TO_OTHER_PROJECTS",
  "checkpoint_delivery_order": [
    "EMAIL_START_NOTICE",
    "SUBSTANTIVE_WORK",
    "EMAIL_END_FULL_CHECKPOINT_RETRY_UNTIL_ACK",
    "CHATGPT_POINTER_ONLY_AFTER_EMAIL_END_ACK",
    "TELEGRAM_WITNESS_OPTIONAL"
  ],
  "ui_policy": {
    "primary_surface": "EMAIL_START_AND_END",
    "advanced_surface": "REPORTS_AND_TECHNICAL_EVIDENCE",
    "progressive_disclosure_required": true,
    "chatgpt_surface": "NO_OUTPUT_BEFORE_END_MAIL_ACK_THEN_POINTER_ONLY",
    "start_mail_before_substantive_work": true,
    "end_watchdog_prevents_user_relaunch_dependency": true,
    "normal_closeout_before_deadline": false,
    "adaptive_estimated_end_window": true
  },
  "close_ownership": {
    "normal_owner": "PRIMARY_ASSISTANT",
    "scheduled_backup_required": false,
    "scheduler_is_normal_path": false,
    "user_message_is_never_trigger": true
  }
}
