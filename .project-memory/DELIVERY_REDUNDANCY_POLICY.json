{
  "schema": "bcp.delivery_redundancy_policy/3",
  "revision": "2026-09-20-R55",
  "status": "CANONICAL_CANDIDATE",
  "channels": {
    "chatgpt": {
      "role": "POINTER_ONLY_AFTER_SUCCESSFUL_EMAIL_CHECKPOINT",
      "delivery_is_not_assumed_reliable": true,
      "detailed_checkpoint_body_forbidden_after_successful_email": true,
      "required_pointer_fields": [
        "MAIL_SENT",
        "KINSHASA_DATE_TIME",
        "CHECKPOINT_ID"
      ],
      "allowed_pointer_example": "Va voir le mail — 20 septembre 2026, 23:38 Kinshasa — BCP-R55-..."
    },
    "email": {
      "role": "SOLE_PRIMARY_DETAILED_HUMAN_CHECKPOINT_DELIVERY",
      "full_checkpoint_body_required": true,
      "subject_must_include_checkpoint_id": true,
      "action_instruction_supersession_required": true,
      "send_before_chat_pointer": true,
      "failure_behavior": "IF_EMAIL_SEND_FAILS_DO_NOT_CLAIM_SENT; CHATGPT_MUST_STATE_EMAIL_DELIVERY_HOLD_AND_MAY_INCLUDE_ONLY_MINIMUM_RECOVERY_INSTRUCTION"
    },
    "telegram": {
      "role": "SECONDARY_WITNESS_ALERT_AND_RECOVERY_NAVIGATION",
      "must_not_replace_email_exact_mirror": true,
      "stale_seen_alerts_are_not_runtime_failures": true
    }
  },
  "cadence": {
    "work_slice_minutes": "8-10",
    "checkpoint_each_slice": true,
    "mail_each_slice": true,
    "blind_retry_loops": false
  },
  "action_message_contract": {
    "one_human_gate_at_a_time": true,
    "latest_action_instruction_supersedes_older_action_instructions": true,
    "checkpoint_id_required": true,
    "manual_first_when_network_is_unreliable": true,
    "chat_pointer_must_not_duplicate_full_checkpoint": true
  },
  "packaging": {
    "single_extraction_preferred": true,
    "nested_zip_for_user_action_forbidden": true,
    "current_folder": "API_BCP/00_INSTALL_CURRENT",
    "replace_current_in_place": true,
    "cleanup_superseded_current_artifacts": true,
    "single_extraction_required_for_user_current": true
  },
  "propagation": "PORT_ON_NEXT_TOUCH_TO_OTHER_PROJECTS",
  "checkpoint_delivery_order": [
    "EMAIL_FULL_CHECKPOINT",
    "CHATGPT_POINTER_ONLY",
    "TELEGRAM_WITNESS_OPTIONAL"
  ],
  "ui_policy": {
    "primary_surface": "EMAIL_FULL_CHECKPOINT",
    "advanced_surface": "REPORTS_AND_TECHNICAL_EVIDENCE",
    "progressive_disclosure_required": true,
    "chatgpt_surface": "POINTER_ONLY_AFTER_MAIL_SENT"
  }
}
