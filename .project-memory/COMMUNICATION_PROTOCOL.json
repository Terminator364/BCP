  "gmail_label": "BCP",
  "continuation_code": "BCPGO BCP",
  "start_sequence": [
    "RECONCILE_OR_CLOSE_ANY_PRIOR_TRANCHE",
    "LOAD_COMMUNICATION_AND_DELIVERY_POLICIES",
    "ESTIMATE_SCOPE_COMPLEXITY_AND_REALISTIC_END_WINDOW",
    "SEND_GMAIL_START_WITH_SCOPE_AND_ESTIMATED_END_WINDOW",
    "VERIFY_START_PROVIDER_ACK_MESSAGE_ID_AND_INBOX_OR_SENT_READBACK",
    "APPLY_GMAIL_LABEL_BCP",
    "PERSIST_ACTIVE_TRANCHE_START_RECEIPT_WITH_ESTIMATE",
    "BEGIN_WORK"
