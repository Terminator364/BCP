    "ACTUAL_RESULT",
    "EVIDENCE",
    "BLOCKERS_OR_HUMAN_GATE",
    "NEXT_UNCOMMITTED_ACTION",
    "INSTALL_OR_USER_ACTION_ONLY_IF_ACTUALLY_READY"
  ],
  "chat_app_reply": "CONCISE_POINTER_TO_GMAIL_PLUS_LOCAL_DATE_TIME_AND_TRUE_GATE_OR_CHECKPOINT",
  "final_reply_gate": {
    "required_delivery_state": "END_ACKNOWLEDGED_OR_CLOSED",
    "rule": "NO_FINAL_CHAT_APP_CLOSEOUT_BEFORE_GMAIL_END_PROVIDER_ACK_AND_DURABLE_LEDGER_RECEIPT"
  },
  "idempotency": "DELIVERY_KEY_PLUS_GMAIL_SEARCH_PLUS_PROVIDER_MESSAGE_ID",
  "threading": "PREFER_END_REPLY_TO_START_THREAD; IF_REPLY_REJECTED, SEARCH_EXISTING_END THEN SEND STANDALONE FALLBACK",
  "network_interruption_policy": "PERSIST_CHECKPOINT_AND_RESUME_SAME_TRANCHE_NEVER_SILENTLY_ABANDON",
  "no_app_closeout_before_end_mail": true,
  "end_mail_required_even_if_user_sends_intermediate_feedback": true,
  "backup_semantics": {
