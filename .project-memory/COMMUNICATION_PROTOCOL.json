    "never_stop_only_because_window_elapsed": true
  },
  "work_rule": "CONTINUE_UNTIL_REAL_CHECKPOINT_TRUE_HUMAN_GATE_OR_OBJECTIVE_TOOL_SAFETY_FAILURE",
