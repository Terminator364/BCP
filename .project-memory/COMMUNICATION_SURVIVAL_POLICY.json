{
  "schema": "bcp.communication_survival_policy/5",
  "revision": "2026-09-21-R76",
  "status": "CANONICAL_CANDIDATE",
  "objective": "Preserve user-visible communication and durable mission continuity across ChatGPT UI instability, PC Internet loss, home Wi-Fi failure, PC reboot/offline periods, Telegram direct transport outage, and conversation handoff.",
  "principles": [
    "NO_SINGLE_COMMUNICATION_CHANNEL_IS_CANONICAL_STATE",
    "EMAIL_IS_PRIMARY_DETAILED_HUMAN_CHECKPOINT",
    "CHATGPT_IS_POINTER_ONLY_AFTER_END_EMAIL_ACK",
    "TELEGRAM_IS_SECONDARY_WITNESS_AND_ALERT_SURFACE",
    "PHONE_EDGE_IS_PRIMARY_LOW_POWER_LOCAL_RELAY_AND_STORE_AND_FORWARD_NODE",
    "DRIVE_IS_DURABLE_REPLICATED_EVIDENCE_NOT_SOLE_RUNTIME_AUTHORITY",
    "GITHUB_MAIN_PLUS_WRITER_FENCE_IS_CANONICAL_SOURCE_STATE",
    "EVERY_DELIVERY_CARRIES_IDEMPOTENCY_AND_RECEIPT_STATE",
    "NO_USER_EH_OH_RELAUNCH_REQUIRED_FOR_END_CHECKPOINT",
    "CLOSEOUT_IS_TIMER_DRIVEN_NOT_USER_MESSAGE_DRIVEN",
    "END_MAIL_SEARCH_BEFORE_SEND_PREVENTS_DUPLICATES",
    "SCHEDULER_COMPLETION_IS_NOT_DELIVERY_PROOF",
    "FOREGROUND_END_SEND_IS_PRIMARY_WHEN_SESSION_IS_ALIVE",
    "DELIVERY_STATE_MACHINE_AND_APPEND_ONLY_DELIVERY_LEDGER_ARE_MANDATORY",
    "PRIMARY_ASSISTANT_OWNS_NORMAL_CLOSE; SCHEDULED_GUARDS_ARE_BACKUP_ONLY",
    "DELIVERY_KEY_IS_REQUIRED_FOR_EVERY_TRANCHE",
    "PRIMARY_ASSISTANT_OWNS_NORMAL_25_MINUTE_CLOSE_WITHOUT_SCHEDULED_AUTOMATION_DEPENDENCY"
  ],
  "channels": {
    "gmail": {
      "priority": 1,
      "role": "PRIMARY_DETAILED_CHECKPOINT",
      "start_before_work": true,
      "end_retry_until_provider_ack": true,
      "project_label": "BCP",
      "body_contains": [
        "checkpoint_id",
        "kinshasa_time",
        "work_done",
        "evidence",
        "next_action_or_gate",
        "continuation_code"
      ],
      "end_delivery_proof": {
        "required": true,
        "proof": "SENT_SEARCH_MATCH_PLUS_PROVIDER_MESSAGE_ID",
        "scheduler_status_insufficient": true,
        "start_and_end_label_required": "BCP"
      },
      "backup_end_payload": {
        "retrieval_dependency": "NONE_REQUIRED_FOR_MINIMAL_FAILSAFE",
        "must_include": [
          "project",
          "tranche_id",
          "closeout_status",
          "latest_durable_checkpoint_pointer",
          "continuation_code",
          "pending_work_truth"
        ],
        "rationale": "A complex GitHub/Drive synthesis must not block the backup END mail."
      }
    },
    "telegram": {
      "priority": 2,
      "role": "SECONDARY_WITNESS_ALERT_AND_RECOVERY_NAVIGATION",
      "direct_path": "PC_TO_TELEGRAM",
      "fallback_path": "PC_TO_PHONE_EDGE_CONNECT_RELAY_TO_TELEGRAM",
      "phone_tls_passthrough": true,
      "delivery_claim_requires_provider_ack": true,
      "outage_state_is_durable": true
    },
    "phone_edge": {
      "priority": 3,
      "role": "PRIMARY_LOW_POWER_LOCAL_COMMUNICATION_AND_STORE_FORWARD_NODE",
      "local_api": true,
      "durable_queue": true,
      "durable_memory": true,
      "store_and_forward": true,
      "boot_restore": true,
      "sim_required": false,
      "transports": [
        "LAN",
        "HOTSPOT",
        "WIFI_DIRECT_WHEN_AUTHORIZED",
        "BLE_PRESENCE_CONTROL",
        "USB_FUTURE_FIELD_GATED"
      ],
      "no_uplink_behavior": "QUEUE_DURABLY_AND_REPLAY_IDEMPOTENTLY"
    },
    "drive": {
      "priority": 4,
      "role": "DURABLE_REPLICATED_TELEMETRY_AND_RECOVERY_EVIDENCE",
      "canonical_runtime_path": [
        "API_BCP",
        "02_TELEMETRY",
        "BCP",
        "BCP_RUNTIME_LATEST.json"
      ],
      "broad_search_default_forbidden": true
    },
    "chatgpt": {
      "priority": 5,
      "role": "INTERACTIVE_POINTER_AND_REASONING_SURFACE_NOT_CANONICAL_STATE",
      "detailed_end_body_after_mail_forbidden": true,
      "cold_bootstrap_code": "BCPGO BCP"
    }
  },
  "checkpoint_protocol": {
    "target_minutes": 25,
    "order": [
      "GMAIL_START_ACK",
      "WORK",
      "DURABLE_CHECKPOINT",
      "GMAIL_END_ACK",
      "CHATGPT_POINTER"
    ],
    "if_chatgpt_ui_disappears": "BACKGROUND_GUARDS_SEND_MINIMAL_END_IF POSSIBLE; DURABLE ACTIVE_TRANCHE REMAINS OPEN UNTIL GMAIL SENT READBACK; NEXT BCPGO RECOVERS WITHOUT USER REEXPLANATION",
    "if_end_email_fails": "RETRY_UNTIL_PROVIDER_ACK_NO_CHATGPT_END_OUTPUT",
    "if_pc_offline": "PHONE_EDGE_QUEUES_LOCAL_EVENTS_AND_PC_RECONCILES_ON_RETURN",
    "if_telegram_direct_fails": "TRY_PHONE_EDGE_RELAY_IF_FRESH_REGISTERED_ELSE_PERSIST_OUTAGE",
    "if_drive_unavailable": "KEEP_LOCAL_DURABLE_STATE_AND_RETRY_WITH_BACKOFF",
    "preclose_snapshot_offset_minutes": 23,
    "normal_closeout_offset_minutes": 23,
    "hard_close_guard_offset_minutes": null,
    "absolute_end_deadline_minutes": 25,
    "if_user_message_arrives_near_deadline": "DO_NOT_TREAT_USER_MESSAGE_AS_CLOSEOUT_TRIGGER; RECONCILE_WITH_TIMER_DRIVEN_END_STATE",
    "foreground_closeout": "PRIMARY_ASSISTANT_AT_T+23_PERSISTS_CLOSE_INTENT_SEARCHES_GMAIL_SENDS_END_VERIFIES_PROVIDER_ACK_PERSISTS_CLOSED_THEN_RETURNS",
    "background_guards": "NOT_REQUIRED_FOR_NORMAL_CLOSE; IF_RUNTIME_DIES_NEXT_SUPPORTED_INVOCATION_RECONCILES_OPEN_TRANCHE_BEFORE_NEW_WORK",
    "scheduler_completion_semantics": "ADVISORY_ONLY_NOT_DELIVERY_PROOF",
    "backup_end_template_ref": ".project-memory/END_FAILSAFE_TEMPLATE.json",
    "useful_work_target_minutes": 23,
    "useful_work_minimum_minutes": 20,
    "normal_close_reserve_minutes": 2,
    "backup_earliest_offset_minutes": null
  },
  "cold_recovery": {
    "code": "BCPGO BCP",
    "load_order": [
      ".project-memory/NEW_CONVERSATION_TAKEOVER.json",
      ".project-memory/COMMUNICATION_PROTOCOL.json",
      ".project-memory/COMMUNICATION_STATE_MACHINE.json",
      ".project-memory/ACTIVE_TRANCHE.json",
      ".project-memory/COMMUNICATION_DELIVERY_LEDGER.jsonl",
      ".project-memory/DELIVERY_REDUNDANCY_POLICY.json",
      ".project-memory/INTERACTIVE_WORK_CADENCE_POLICY.json",
      ".project-memory/COMMUNICATION_SURVIVAL_POLICY.json",
      ".project-memory/GIT_WRITER_LEASE_POLICY.json",
      ".project-memory/END_FAILSAFE_TEMPLATE.json",
      ".project-memory/UNIVERSAL_CONTINUATION_CODE_REGISTRY.json",
      "project_state.json",
      "API_PROJECT_CONTINUITY.md",
      "release/current.json"
    ],
    "user_reexplanation_required": false,
    "next_action_source": "project_state.next_action",
    "writer_fence_required_before_mutation": true,
    "active_tranche_state_ref": ".project-memory/ACTIVE_TRANCHE.json",
    "takeover_policy_ref": ".project-memory/NEW_CONVERSATION_TAKEOVER.json",
    "communication_protocol_ref": ".project-memory/COMMUNICATION_PROTOCOL.json",
    "communication_state_machine_ref": ".project-memory/COMMUNICATION_STATE_MACHINE.json",
    "delivery_ledger_ref": ".project-memory/COMMUNICATION_DELIVERY_LEDGER.jsonl"
  },
  "anti_false_success": {
    "telegram_sent_requires_provider_message_id_or_success_receipt": true,
    "gmail_sent_requires_provider_send_ack": true,
    "drive_mirror_is_not_user_seen": true,
    "chatgpt_visible_is_not_assumed": true,
    "phone_queue_accepted_is_not_remote_delivery": true,
    "gmail_end_exists_requires": "DELIVERY_KEY_MATCH_PLUS_SENT_MESSAGE_ID_PLUS_SEARCH_READBACK",
    "duplicate_end_prevention": "SEARCH_BY_CHECKPOINT_ID_BEFORE_SEND",
    "scheduler_completed_is_not_delivery": true,
    "user_relaunch_must_never_be_delivery_trigger": true
  }
}
